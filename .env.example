# ============================================
# PLAYBEAT DIGITAL - ENVIRONMENT CONFIGURATION
# ============================================

# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/playbeat?retryWrites=true&w=majority

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this
JWT_REFRESH_EXPIRES_IN=30d

# Server
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# CORS
CORS_ORIGIN=http://localhost:5173

# Admin Seed
ADMIN_EMAIL=admin@playbeat.digital
ADMIN_PASSWORD=ChangeMe123!

# Payment Providers (configure as needed)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@playbeat.digital

# Cloud Storage (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis (optional, for caching/sessions)
REDIS_URL=

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
